# PostgreSQL (enable the postgis extension on this DB)
DATABASE_URL="postgresql://user:password@localhost:5432/petcare?schema=public"

# Firebase Admin SDK (download service account JSON from Firebase console)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# App
PORT=3000
JWT_SECRET=change-me
